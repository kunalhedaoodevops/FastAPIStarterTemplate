{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": false
        },
        {
            "name": "React Debug (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/fastapi-ui",
            "sourceMaps": true,
            "preLaunchTask": "Start React App"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Debug (FastAPI + React)",
            "configurations": [
                "FastAPI Debug",
                "React Debug (Chrome)"
            ]
        }
    ]
}
